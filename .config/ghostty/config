theme = Builtin Tango Dark
font-family = jetbrains mono
font-size = 22
font-feature = -liga, -calt
background-opacity = 1.00
# ===
initial-command = "/opt/homebrew/bin/tmux new-session -s k44n -A"

macos-option-as-alt = true
macos-titlebar-style = hidden
title = " "

keybind = global:cmd+ctrl+t=toggle_quick_terminal
keybind = ctrl+f>minus=set_font_size:18.0
keybind = ctrl+f>equal=set_font_size:22.0
keybind = ctrl+f>shift+equal=set_font_size:28.0

custom-shader = ~/.config/ghostty/ghostty-shaders/tft.glsl

